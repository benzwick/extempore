;;; ex1p.xtm -- MFEM Example 1p (Parallel Poisson equation)
;;;
;;; Parallel version of ex1.xtm using MPI and HYPRE.
;;;
;;; NOTE: This example requires:
;;; - MFEM built with MPI support (MFEM_USE_MPI)
;;; - Extempore MPI bindings
;;; - HYPRE linear solvers
;;;
;;; Compile: (sys:load "examples/external/mfem/examples/ex1p.xtm")
;;; Run with MPI: mpirun -np 4 extempore --run ex1p.xtm

;; Load MFEM library
(sys:load "libs/external/mfem.xtm")

(println "\n==================================================")
(println "MFEM Example 1p - Parallel Poisson Equation")
(println "==================================================")
(println "\nNOTE: This example requires MPI support.")
(println "See ex1.xtm for the serial implementation.")
(println "Parallel version follows same structure with Par* types.")
